{
  "name": "dsh-network-proxy",
  "version": "2.0.1",
  "description": "DeepSeek Assistant 的网络代理管理插件：在设置页切换 跟随系统 / 手动代理 / 直连，即时生效。 Network proxy manager for DSH 0.2.x.",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "PATCHES.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "dependencies": {
    "undici": "^7.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "engines": {
    "node": ">=20.18.1",
    "dsh": ">=0.2.0-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "network"
  ],
  "license": "MIT"
}
